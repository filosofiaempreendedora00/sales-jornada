# Configuração do banco Postgres (Cloud SQL).
# Copie pra .env (NUNCA commitar) ou configure no Render como env vars.

# Credenciais do Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Opcional: SSL (1 = ativa, com rejectUnauthorized:false)
# Cloud SQL via IP público funciona sem SSL pra IPs whitelist.
DB_SSL=0

# IA (já existia)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5
